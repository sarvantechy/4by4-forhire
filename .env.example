# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Public application URLs
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Public, mobile-restricted MapTiler key used by MapLibre map styles.
EXPO_PUBLIC_MAPTILER_KEY=replace-with-maptiler-key

# Local infrastructure defaults only; replace outside local development
DATABASE_URL=postgresql+psycopg://forhire:forhire_local@localhost:15432/forhire
POSTGRES_DB=forhire
POSTGRES_USER=forhire
POSTGRES_PASSWORD=forhire_local
POSTGRES_PORT=15432
REDIS_URL=redis://localhost:16379/0
REDIS_PORT=16379
S3_ENDPOINT_URL=http://localhost:19000
S3_REGION=ap-south-2
S3_BUCKET=forhire-local
S3_ACCESS_KEY_ID=forhire_local
S3_SECRET_ACCESS_KEY=replace-for-local-development
S3_PORT=19000
S3_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=18025
MAILPIT_UI_PORT=18080
SMTP_HOST=127.0.0.1
SMTP_PORT=18025
VERIFICATION_FROM_EMAIL=no-reply@forhire.local
PRIVACY_CONTACT_EMAIL=support@4by4softwares.com
SKIP_IDENTITY_VERIFICATION=true
# Required outside development/test when the temporary no-OTP bypass is enabled.
VERIFICATION_BYPASS_EXPIRES_AT=

# Authentication placeholders; never use these values outside local development
SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Browser access
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001